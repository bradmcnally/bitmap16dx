      "platform_zero/store/palettes.png"
    ],
    "categories": [
      "Creative & Office"
    ],
    "permissions": {
      "camera": false,
      "microphone": false,
      "imu": true,
      "network": true,
      "additional_hardware": false,
      "background_service": false,
      "external_display": false
    },
    "author": {
      "display_name": "Brad McNally",
      "github": "bradmcnally"
    },
